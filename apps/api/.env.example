APP_NAME="CRM Dermacells"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_URL=http://localhost:8000

APP_LOCALE=es_AR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres (DEV) — uses migration_role for migrate, app_role for runtime
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dermacells_dev
DB_USERNAME=app_role
DB_PASSWORD=app_dev_pass
DB_SCHEMA=public
DB_SSLMODE=prefer
DB_STICKY=true
# Set to true ONLY when running behind PgBouncer in transaction pool mode.
# Disabled in dev because PDO emulated prepares break native boolean binding.
DB_EMULATE_PREPARES=false

# Migration role (used only by deploy scripts)
DB_MIGRATION_USERNAME=migration_role
DB_MIGRATION_PASSWORD=migration_dev_pass

# Worker role (Horizon)
DB_WORKER_USERNAME=worker_role
DB_WORKER_PASSWORD=worker_dev_pass

# Test DB
DB_TEST_DATABASE=dermacells_test

# Sanctum SPA
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173,localhost
SESSION_DOMAIN=localhost
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# Broadcasting via Reverb
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
HORIZON_PREFIX=dermacells_horizon:
HORIZON_DOMAIN=null
HORIZON_PATH=horizon

CACHE_STORE=redis
CACHE_PREFIX=dermacells_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# AWS — sa-east-1 prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_SECRETS_MANAGER_ID=dermacells/dev

# OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_HD_ALLOWLIST=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
MICROSOFT_TID_ALLOWLIST=

# OAuth mobile redirect (Expo deep link)
MOBILE_OAUTH_REDIRECT=dermacells://oauth/callback

# Audit log
AUDIT_HMAC_KEY=base64:CHANGE_ME_GENERATE_RANDOM_32_BYTES

# Filament admin gate
ADMIN_IP_ALLOWLIST=127.0.0.1,::1

# AI providers (DB-backed; these are fallback only, real values in ai_settings)
AI_GLOBAL_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Xubio
XUBIO_BASE_URL=https://xubio.com/API/1.1
XUBIO_TOKEN_URL=https://xubio.com/API/1.1/TokenEndpoint
XUBIO_CLIENT_ID=
XUBIO_CLIENT_SECRET=

# BCRA Estadísticas Cambiarias (no auth)
BCRA_BASE_URL=https://api.bcra.gob.ar/estadisticascambiarias/v1.0

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Firebase (FCM)
FIREBASE_CREDENTIALS=storage/firebase-credentials.json
FIREBASE_PROJECT_ID=

VITE_APP_NAME="${APP_NAME}"
