{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "placeholder@dermacells.com.ar",
        "ascAppId": "PLACEHOLDER_APP_STORE_ID",
        "appleTeamId": "PLACEHOLDER_TEAM_ID",
        "bundleIdentifier": "ar.com.dermacells.crm",
        "ascApiKeyPath": "./asc-config.json",
        "language": "es-AR",
        "metadataPath": "./store-metadata"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "applicationId": "ar.com.dermacells.crm",
        "releaseStatus": "draft"
      }
    }
  },
  "update": {
    "channel": "production"
  }
}
