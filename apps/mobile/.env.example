# Copy this file to .env and fill in the values before running the app.
# NEVER commit .env to git.

# Backend API base URL (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Google OAuth (from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
# For mobile: use the "iOS" or "Android" OAuth client, NOT the web client.
# For dev: use the web client and set authorized redirect URIs to include exp://
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Microsoft OAuth (from Azure AD -> App registrations)
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_TENANT_ID=common

# EAS project ID (from eas.json or https://expo.dev)
EXPO_PUBLIC_EAS_PROJECT_ID=

# Sentry (mobile)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
EXPO_PUBLIC_SENTRY_RELEASE=
